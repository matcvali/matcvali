---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import { idiomas, langs, t, type Lang } from '../i18n/ui';
import { url, perfil } from '../lib/util';

interface Props {
  lang: Lang;
  titulo?: string;
  descricao?: string;
}
const { lang, titulo, descricao } = Astro.props;
const p = perfil();
const nomeSite = p.nome_curto || p.nome;
const tituloFinal = titulo ? `${titulo} | ${nomeSite}` : nomeSite;
const desc = descricao || p.bio || '';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caminhoAtual = Astro.url.pathname.slice(base.length); // ex.: /pt/biblioteca/
const resto = caminhoAtual.replace(/^\/(pt|en|es)(?=\/|$)/, '');
const linkIdioma = (l: Lang) => url(`/${l}${resto || '/'}`);

const menu = [
  { href: `/${lang}/biblioteca/`, rotulo: t(lang, 'nav.biblioteca') },
  { href: `/${lang}/caminho/`, rotulo: t(lang, 'nav.caminho') },
  { href: `/${lang}/interesses/`, rotulo: t(lang, 'nav.interesses') },
  { href: `/${lang}/documentos/`, rotulo: t(lang, 'nav.documentos') },
  { href: `/${lang}/curriculo/`, rotulo: t(lang, 'nav.curriculo') },
];
const ativo = (href: string) => caminhoAtual.startsWith(href);
const ano = new Date().getFullYear();
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={desc} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={linkIdioma(l)} />)}
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#conteudo">{t(lang, 'geral.pular')}</a>

    <header class="topo">
      <nav class="barra wrap" aria-label="Menu">
        <a class="marca" href={url(`/${lang}/`)}>
          <span class="marca-ponto" aria-hidden="true"></span>
          {nomeSite}
        </a>

        <ul class="menu">
          {menu.map((m) => (
            <li>
              <a href={url(m.href)} aria-current={ativo(m.href) ? 'page' : undefined}>{m.rotulo}</a>
            </li>
          ))}
        </ul>

        <div class="ferramentas">
          <div class="idiomas" role="group" aria-label={t(lang, 'geral.idioma')}>
            {langs.map((l) => (
              <a href={linkIdioma(l)} hreflang={l} title={idiomas[l]} aria-current={l === lang ? 'true' : undefined}>
                {l.toUpperCase()}
              </a>
            ))}
          </div>
          <button class="tema" type="button" aria-label={t(lang, 'geral.tema')} title={t(lang, 'geral.tema')}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.4 5.4 0 0 1-8.54-6.54A9 9 0 0 0 12 3Z" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <svg class="onda" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 40 C 240 90, 480 -10, 720 40 S 1200 90, 1440 40 V80 H0 Z" fill="currentColor" />
      </svg>
      <div class="rodape-corpo">
        <div class="wrap rodape-grade">
          <div>
            <p class="rodape-nome">{p.nome}</p>
            {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
          </div>
          <ul class="rodape-links">
            {p.lattes && <li><a href={p.lattes} rel="noopener" target="_blank">Lattes</a></li>}
            {(p.links || []).map((l: any) => (
              <li><a href={l.url} rel="noopener" target="_blank">{l.nome}</a></li>
            ))}
          </ul>
          <p class="rodape-ano">© {ano}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('.tema')?.addEventListener('click', () => {
        const root = document.documentElement;
        const escuroAgora =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const novo = escuroAgora ? 'light' : 'dark';
        root.dataset.theme = novo;
        try { localStorage.setItem('tema', novo); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .topo {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding-inline: 12px;
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 16px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 8px 8px 8px 20px;
    max-width: calc(var(--max) - 40px);
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-weight: 650;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .marca-ponto {
    width: 14px;
    height: 14px;
    background: var(--orange);
    border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%;
  }
  .menu {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0 auto;
    padding: 0;
  }
  .menu a {
    display: block;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
  }
  .menu a:hover { background: var(--surface); color: var(--ink); }
  .menu a[aria-current='page'] { background: var(--surface-2); color: var(--orange-ink); }

  .ferramentas { display: flex; align-items: center; gap: 6px; }
  .idiomas {
    display: flex;
    background: var(--surface);
    border-radius: var(--r-pill);
    padding: 3px;
  }
  .idiomas a {
    padding: 4px 9px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
  }
  .idiomas a[aria-current='true'] { background: var(--accent); color: var(--on-accent); }
  .tema {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .tema:hover { background: var(--surface-2); }

  @media (max-width: 900px) {
    .barra { flex-wrap: wrap; border-radius: var(--r-lg); padding: 10px 12px 10px 18px; row-gap: 6px; }
    .ferramentas { margin-left: auto; }
    .menu {
      order: 3;
      width: 100%;
      margin: 0;
      flex-wrap: wrap;
      justify-content: center;
    }
    .menu a { white-space: nowrap; padding: 6px 11px; font-size: 0.9rem; }
  }

  main { min-height: 60vh; padding-bottom: 80px; }

  .rodape { color: var(--surface); margin-top: 40px; }
  .onda { display: block; width: 100%; height: 60px; }
  .rodape-corpo { background: var(--surface); color: var(--ink); padding: 24px 0 48px; }
  .rodape-grade {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-start;
    justify-content: space-between;
  }
  .rodape-nome { font-family: var(--font-display); font-size: 1.3rem; margin: 0 0 4px; font-variation-settings: 'SOFT' 100; }
  .rodape-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .rodape-ano { color: var(--muted); margin: 0; }
</style>
