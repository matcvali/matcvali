---
import '@fontsource-variable/figtree';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { idiomas, langs, t, type Lang } from '../i18n/ui';
import { url, perfil, campo } from '../lib/util';
import BoasVindas from '../components/BoasVindas.astro';

interface Props {
  lang: Lang;
  titulo?: string;
  descricao?: string;
}
const { lang, titulo, descricao } = Astro.props;
const p = perfil();
const nomeSite = p.nome_curto || p.nome;
const tituloFinal = titulo ? `${titulo} | ${nomeSite}` : nomeSite;
const desc = descricao || p.bio || '';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caminhoAtual = Astro.url.pathname.slice(base.length); // ex.: /pt/biblioteca/
const resto = caminhoAtual.replace(/^\/(pt|en|es)(?=\/|$)/, '');
const linkIdioma = (l: Lang) => url(`/${l}${resto || '/'}`);

const menu = [
  { href: `/${lang}/biblioteca/`, rotulo: t(lang, 'nav.biblioteca') },
  { href: `/${lang}/caminho/`, rotulo: t(lang, 'nav.caminho') },
  { href: `/${lang}/interesses/`, rotulo: t(lang, 'nav.interesses') },
  { href: `/${lang}/documentos/`, rotulo: t(lang, 'nav.documentos') },
  { href: `/${lang}/curriculo/`, rotulo: t(lang, 'nav.curriculo') },
];
const ativo = (href: string) => caminhoAtual.startsWith(href);
const naInicial = /^\/(pt|en|es)\/?$/.test(caminhoAtual);
const ano = new Date().getFullYear();
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloFinal}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={desc} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={linkIdioma(l)} />)}
    <script is:inline>
      try {
        const t = localStorage.getItem('tema');
        if (t) document.documentElement.dataset.theme = t;
        // Apresentação: completa na primeira visita; só as boas-vindas nas seguintes.
        if (sessionStorage.getItem('bv-saida')) {
          sessionStorage.removeItem('bv-saida');
          document.documentElement.dataset.bv = 'saida';
        } else if (!localStorage.getItem('bv')) {
          localStorage.setItem('bv-teste', '1');
          localStorage.removeItem('bv-teste');
          document.documentElement.dataset.bv = 'inicio';
          sessionStorage.setItem('bv-sessao', '1');
        } else if (!sessionStorage.getItem('bv-sessao')) {
          // Visitas seguintes: só as boas-vindas, uma vez por sessão do navegador.
          sessionStorage.setItem('bv-sessao', '1');
          document.documentElement.dataset.bv = 'rapido';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="aura" aria-hidden="true"><i></i><i></i><i></i></div>
    <BoasVindas lang={lang} nome={p.nome} />
    <a class="sr-only" href="#conteudo">{t(lang, 'geral.pular')}</a>

    <header class="topo">
      <nav class="barra wrap" aria-label={t(lang, 'geral.menu')}>
        <a class="marca" href={url(`/${lang}/`)}>
          <span class="marca-ponto" aria-hidden="true"></span>
          {nomeSite}
        </a>

        <ul class="menu">
          <li>
            <a class="casa" href={url(`/${lang}/`)} aria-current={naInicial ? 'page' : undefined} aria-label={t(lang, 'nav.inicio')} title={t(lang, 'nav.inicio')}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path fill="currentColor" d="M10.6 3.6a2.2 2.2 0 0 1 2.8 0l7 5.8c.4.4.6.9.6 1.4V19a2.5 2.5 0 0 1-2.5 2.5h-3.2a1 1 0 0 1-1-1v-4.6a1.3 1.3 0 0 0-1.3-1.3h-2a1.3 1.3 0 0 0-1.3 1.3v4.6a1 1 0 0 1-1 1H5.5A2.5 2.5 0 0 1 3 19v-8.2c0-.5.2-1 .6-1.4l7-5.8Z" />
              </svg>
            </a>
          </li>
          {menu.map((m) => (
            <li>
              <a href={url(m.href)} aria-current={ativo(m.href) ? 'page' : undefined}>{m.rotulo}</a>
            </li>
          ))}
        </ul>

        <div class="ferramentas">
          <div class="idiomas" role="group" aria-label={t(lang, 'geral.idioma')}>
            {langs.map((l) => (
              <a href={linkIdioma(l)} hreflang={l} title={idiomas[l]} aria-current={l === lang ? 'true' : undefined}>
                {l.toUpperCase()}
              </a>
            ))}
          </div>
          <button class="tema" type="button" aria-label={t(lang, 'geral.tema')} title={t(lang, 'geral.tema')}>
            <svg class="lua" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
              <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.4 5.4 0 0 1-8.54-6.54A9 9 0 0 0 12 3Z" />
            </svg>
            <svg class="sol" viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" fill="currentColor" />
              <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape wrap">
      <div class="rodape-corpo vidro">
        <div class="rodape-grade">
          <div>
            <p class="rodape-nome">{p.nome}</p>
            {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
          </div>
          <ul class="rodape-links">
            {p.lattes && <li><a href={p.lattes} rel="noopener" target="_blank">{t(lang, 'geral.lattes')}</a></li>}
            {(p.links || []).map((l: any) => (
              <li><a href={l.url} rel="noopener" target="_blank">{campo(l, 'nome', lang)}</a></li>
            ))}
          </ul>
          <p class="rodape-ano">
            <a href={url(`/${lang}/sobre-o-site/`)}>{t(lang, 'sobre.link')}</a>
            <span>© {ano}</span>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('.tema')?.addEventListener('click', () => {
        const root = document.documentElement;
        const escuroAgora =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const novo = escuroAgora ? 'light' : 'dark';
        const aplicar = () => { root.dataset.theme = novo; };
        // Transição suave entre os temas, onde o navegador permite.
        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.startViewTransition(aplicar);
        } else {
          aplicar();
        }
        try { localStorage.setItem('tema', novo); } catch (e) {}
      });
      // Guarda o idioma escolhido no menu, para a próxima visita abrir nele.
      document.querySelectorAll('.idiomas a').forEach((a) =>
        a.addEventListener('click', () => {
          try { localStorage.setItem('idioma', a.getAttribute('hreflang')); } catch (e) {}
        }),
      );
    </script>
  </body>
</html>

<style>
  .topo {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding-inline: 12px;
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--surface);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow);
    border-radius: var(--r-pill);
    padding: 8px 8px 8px 20px;
    max-width: calc(var(--max) - 40px);
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .marca-ponto {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--orange), var(--lilac));
  }
  .menu {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0 auto;
    padding: 0;
  }
  .menu a {
    display: block;
    padding: 8px 14px;
    border-radius: var(--r-pill);
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.93rem;
    color: var(--muted);
  }
  .menu a:hover { background: var(--surface-2); color: var(--ink); }
  .menu a.casa { display: grid; place-items: center; padding: 8px 11px; }
  .menu a.casa svg { display: block; }
  .menu a[aria-current='page'] { background: var(--ink); color: var(--bg); }

  .ferramentas { display: flex; align-items: center; gap: 6px; }
  .idiomas {
    display: flex;
    background: var(--surface-2);
    border-radius: var(--r-pill);
    padding: 3px;
  }
  .idiomas a {
    padding: 4px 9px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
    text-decoration: none;
  }
  .idiomas a[aria-current='true'] { background: var(--accent); color: var(--on-accent); }
  .tema {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink);
    cursor: pointer;
  }
  .tema .sol { display: none; }
  :global(:root[data-theme='dark']) .tema .sol { display: block; }
  :global(:root[data-theme='dark']) .tema .lua { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .tema .sol { display: block; }
    :global(:root:not([data-theme='light'])) .tema .lua { display: none; }
  }
  .tema:hover { color: var(--orange-ink); }

  @media (max-width: 900px) {
    .barra { flex-wrap: wrap; border-radius: var(--r-lg); padding: 10px 12px 10px 18px; row-gap: 6px; }
    .ferramentas { margin-left: auto; }
    .menu {
      order: 3;
      width: 100%;
      margin: 0;
      flex-wrap: wrap;
      justify-content: center;
    }
    .menu a { white-space: nowrap; padding: 6px 11px; font-size: 0.9rem; }
  }

  main { min-height: 60vh; padding-bottom: 80px; }

  .rodape { margin-top: 40px; padding-bottom: 24px; }
  .rodape-corpo { padding: 28px 32px; }
  .rodape-grade {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: flex-start;
    justify-content: space-between;
  }
  .rodape-nome { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; margin: 0 0 4px; }
  .rodape-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .rodape-ano { color: var(--muted); margin: 0; display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }
  @media (max-width: 640px) { .rodape-ano { align-items: flex-start; } }
</style>
