---
// Histórias da página inicial: os cartões e a janela que abre com o texto completo.
// Tudo acontece na própria página inicial; não existem páginas separadas.
import HistoriaCard from './HistoriaCard.astro';
import Ilustracao from './Ilustracao.astro';
import { t, type Lang } from '../i18n/ui';
import { url, campo, markdown } from '../lib/util';
interface Props { historias: any[]; lang: Lang }
const { historias, lang } = Astro.props;
const titulo = t(lang, 'hist.secao').trim();
const texto = (h: any) => {
  const traduzido = lang !== 'pt' ? h.data[`texto_${lang}`] : null;
  return { html: markdown(traduzido || h.body || ''), faltaTraducao: lang !== 'pt' && !traduzido };
};
---
<section class="wrap historias" aria-label={titulo || undefined}>
  {titulo && <h2>{titulo}</h2>}
  <div class="grade">
    {historias.map((h) => <HistoriaCard historia={h} lang={lang} />)}
  </div>
</section>

{historias.map((h) => {
  const { html, faltaTraducao } = texto(h);
  return (
    <dialog class="janela" id={`historia-${h.id}`} aria-labelledby={`historia-${h.id}-t`}>
      <div class="painel">
        <button type="button" class="fechar" data-fecha aria-label={t(lang, 'hist.fechar')} title={t(lang, 'hist.fechar')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <div class="capa">
          {h.data.capa ? <img src={url(h.data.capa)} alt="" /> : <Ilustracao semente={h.id} class="ilu" />}
        </div>
        <div class="conteudo">
          <h2 id={`historia-${h.id}-t`}>{campo(h.data, 'titulo', lang)}</h2>
          {campo(h.data, 'resumo', lang) && <p class="lede">{campo(h.data, 'resumo', lang)}</p>}
          {faltaTraducao && <p class="aviso">{t(lang, 'geral.traducao')}</p>}
          <div class="prose" set:html={html} />
        </div>
      </div>
    </dialog>
  );
})}

<script>
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const vt = (fn: () => void) =>
    (document as any).startViewTransition && !calmo ? (document as any).startViewTransition(fn) : fn();

  let cartaoAberto: HTMLElement | null = null;

  function abrir(id: string, cartao?: HTMLElement | null) {
    const janela = document.getElementById(`historia-${id}`) as HTMLDialogElement | null;
    if (!janela || janela.open) return;
    cartaoAberto = cartao || document.querySelector(`[data-abre="${id}"]`);
    const painel = janela.querySelector<HTMLElement>('.painel')!;
    // O cartão "vira" a janela: os dois recebem o mesmo nome durante a transição.
    if (cartaoAberto) cartaoAberto.style.viewTransitionName = 'historia';
    vt(() => {
      if (cartaoAberto) cartaoAberto.style.viewTransitionName = '';
      painel.style.viewTransitionName = 'historia';
      janela.showModal();
      janela.scrollTop = 0;
      document.documentElement.classList.add('janela-aberta');
    });
    history.replaceState(null, '', `#${id}`);
  }

  function fechar(janela: HTMLDialogElement) {
    const painel = janela.querySelector<HTMLElement>('.painel')!;
    const t = vt(() => {
      painel.style.viewTransitionName = '';
      janela.close();
      document.documentElement.classList.remove('janela-aberta');
      if (cartaoAberto) cartaoAberto.style.viewTransitionName = 'historia';
    });
    const limpar = () => {
      if (cartaoAberto) cartaoAberto.style.viewTransitionName = '';
      cartaoAberto?.focus({ preventScroll: true });
    };
    if (t && t.finished) t.finished.then(limpar);
    else limpar();
    history.replaceState(null, '', location.pathname + location.search);
  }

  document.querySelectorAll<HTMLElement>('[data-abre]').forEach((c) =>
    c.addEventListener('click', () => abrir(c.dataset.abre!, c)),
  );
  document.querySelectorAll<HTMLDialogElement>('dialog.janela').forEach((j) => {
    j.querySelector('[data-fecha]')!.addEventListener('click', () => fechar(j));
    // Clique fora do painel fecha.
    j.addEventListener('click', (e) => { if (e.target === j) fechar(j); });
    // Esc fecha com a mesma animação.
    j.addEventListener('cancel', (e) => { e.preventDefault(); fechar(j); });
  });

  // Link direto para uma história (ex.: .../pt/#o-que-me-motivou).
  const alvo = decodeURIComponent(location.hash.slice(1));
  if (alvo && document.getElementById(`historia-${alvo}`)) {
    const esperar = () => (document.documentElement.dataset.bv ? setTimeout(esperar, 300) : abrir(alvo));
    setTimeout(esperar, 200);
  }
</script>

<style>
  .historias { margin-bottom: 56px; }
  .historias h2 { font-size: 1.5rem; margin-bottom: 18px; }
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .janela {
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    background: transparent;
    color: var(--ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .janela::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .painel {
    position: relative;
    width: min(760px, 100% - 32px);
    margin: 48px auto;
    padding: 10px;
    background: var(--bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
    box-shadow: 0 30px 80px rgba(20, 12, 40, 0.25);
  }
  .fechar {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    backdrop-filter: blur(12px);
  }
  .fechar:hover { background: var(--surface-2); }
  .capa { aspect-ratio: 16 / 8; border-radius: calc(var(--r-lg) - 8px); overflow: hidden; }
  .capa img, .capa :global(.ilu) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .conteudo { padding: 28px clamp(16px, 4vw, 40px) 36px; }
  .conteudo h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); margin: 0 0 10px; }
  .conteudo .lede { margin-bottom: 24px; }
  .aviso { margin-bottom: 20px; }
  .prose :global(img) { margin: 1.4em 0; width: 100%; height: auto; }
  .prose :global(p), .prose :global(li) { line-height: 1.75; }

  :global(html.janela-aberta) { overflow: hidden; }

  /* Sem suporte à transição entre elementos: a janela aparece com um zoom suave. */
  @supports not (view-transition-name: none) {
    .janela[open] .painel { animation: surgir 0.4s cubic-bezier(.2,.8,.2,1); }
    @keyframes surgir { from { opacity: 0; transform: translateY(20px) scale(0.97); } }
  }
  :global(::view-transition-group(historia)) { animation-duration: 0.5s; animation-timing-function: cubic-bezier(.2,.8,.2,1); }

  @media (max-width: 560px) {
    .painel { margin: 16px auto; width: calc(100% - 16px); }
  }
</style>
