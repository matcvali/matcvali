---
// Capa de livro. Se não houver imagem, desenha uma capa com o título.
import { url } from '../lib/util';
interface Props { titulo: string; autor: string; capa?: string | null; grande?: boolean }
const { titulo, autor, capa, grande = false } = Astro.props;

const tons = [
  ['var(--orange)', '#2d1b26'],
  ['var(--plum)', 'var(--bg)'],
  ['var(--apricot)', 'var(--ink)'],
  ['var(--amber)', '#2d1b26'],
  ['var(--surface-2)', 'var(--ink)'],
];
let h = 0;
for (const c of titulo) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const [fundo, texto] = tons[h % tons.length];
---
<div class:list={['capa', { grande }]} style={`--fundo:${fundo};--texto:${texto}`}>
  {capa
    ? <img src={url(capa)} alt="" loading="lazy" />
    : (
      <div class="capa-gerada" aria-hidden="true">
        <span class="capa-titulo">{titulo}</span>
        <span class="capa-autor">{autor}</span>
      </div>
    )}
</div>

<style>
  .capa {
    aspect-ratio: 2 / 3;
    border-radius: 10px 20px 20px 10px;
    overflow: hidden;
    background: var(--fundo);
    color: var(--texto);
    box-shadow: inset 6px 0 0 rgb(0 0 0 / 0.08);
  }
  .capa img { width: 100%; height: 100%; object-fit: cover; }
  .capa-gerada {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px 14px 14px 18px;
  }
  .capa-titulo {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.15;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .capa-autor { font-size: 0.75rem; font-weight: 600; opacity: 0.8; }
  .grande .capa-titulo { font-size: 1.6rem; }
  .grande .capa-autor { font-size: 0.95rem; }
  .grande .capa-gerada { padding: 26px 22px 22px 28px; }
</style>
