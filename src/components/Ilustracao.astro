---
// Ilustração desenhada para histórias sem capa: órbitas e pontos em degradê,
// sempre a mesma para a mesma história (depende do texto da "semente").
interface Props { semente: string; class?: string }
const { semente, class: classe } = Astro.props;

let h = 2166136261;
for (const c of semente) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
const aleatorio = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0) % 1000) / 1000;

const id = `il-${(h >>> 0).toString(36)}`;
const giro = Math.round(aleatorio() * 180);
const aneis = 2 + Math.floor(aleatorio() * 3);
const cx = 150 + aleatorio() * 100;
const cy = 90 + aleatorio() * 40;
const pontos = Array.from({ length: 4 }, () => ({
  x: Math.round(30 + aleatorio() * 340),
  y: Math.round(20 + aleatorio() * 200),
  r: 2 + Math.round(aleatorio() * 4),
}));
const pares = [
  ['var(--blob-1)', 'var(--blob-2)'],
  ['var(--blob-2)', 'var(--blob-3)'],
  ['var(--blob-3)', 'var(--blob-1)'],
];
const [c1, c2] = pares[Math.floor(aleatorio() * pares.length)];
---
<svg class={classe} viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-f`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={c1} stop-opacity="0.75" />
      <stop offset="1" stop-color={c2} stop-opacity="0.75" />
    </linearGradient>
    <linearGradient id={`${id}-l`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--orange)" />
      <stop offset="1" stop-color="var(--lilac)" />
    </linearGradient>
  </defs>
  <rect width="400" height="250" fill="var(--bg)" />
  <rect width="400" height="250" fill={`url(#${id}-f)`} />
  <g fill="none" stroke={`url(#${id}-l)`} stroke-width="1.6" opacity="0.85">
    {Array.from({ length: aneis }, (_, i) => (
      <ellipse cx={cx} cy={cy} rx={170 - i * 22} ry={52 - i * 6} transform={`rotate(${giro + i * (180 / aneis)} ${cx} ${cy})`} />
    ))}
  </g>
  <circle cx={cx} cy={cy} r="14" fill="var(--orange)" opacity="0.9" />
  <circle cx={cx} cy={cy} r="30" fill="var(--orange)" opacity="0.18" />
  {pontos.map((p, i) => <circle cx={p.x} cy={p.y} r={p.r} fill={i % 2 ? 'var(--lilac)' : 'var(--ink)'} opacity="0.7" />)}
</svg>
