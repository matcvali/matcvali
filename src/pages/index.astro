---
import { url } from '../lib/util';
const destinos = { pt: url('/pt/'), en: url('/en/'), es: url('/es/') };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`1; url=${destinos.pt}`} />
    <title>Redirecionando</title>
    <style is:inline>
      html { background: #fbf8ff; }
      @media (prefers-color-scheme: dark) { html:not([data-theme='light']) { background: #0e0b1d; } }
      html[data-theme='dark'] { background: #0e0b1d; }
    </style>
    <script is:inline define:vars={{ destinos }}>
      try { const t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
      let l = (navigator.language || 'pt').slice(0, 2);
      try { l = localStorage.getItem('idioma') || l; } catch (e) {}
      location.replace(destinos[l] || destinos.pt);
    </script>
  </head>
  <body><a href={destinos.pt}>Entrar</a></body>
</html>
