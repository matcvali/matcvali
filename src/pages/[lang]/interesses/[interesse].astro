---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { langs, t, type Lang } from '../../../i18n/ui';
import { url, campo, paragrafos } from '../../../lib/util';

export async function getStaticPaths() {
  const lista = await getCollection('interesses');
  return langs.flatMap((lang) =>
    lista.map((item) => ({ params: { lang, interesse: item.id }, props: { item } })),
  );
}
const lang = Astro.params.lang as Lang;
const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
const traduzido = lang !== 'pt' ? (d as any)[`texto_${lang}`] : null;
---
<Base lang={lang} titulo={campo(d, 'titulo', lang)} descricao={campo(d, 'resumo', lang)}>
  <article class="wrap interesse">
    <a class="voltar" href={url(`/${lang}/interesses/`)}>← {t(lang, 'int.voltar')}</a>
    <header>
      <h1>{campo(d, 'titulo', lang)}</h1>
      <p class="lede">{campo(d, 'resumo', lang)}</p>
      {d.desde && <span class="pill">{t(lang, 'int.desde')} {d.desde}</span>}
    </header>

    {traduzido
      ? <div class="prose" set:html={paragrafos(traduzido)} />
      : (
        <>
          {lang !== 'pt' && <p class="aviso">{t(lang, 'geral.traducao')}</p>}
          <div class="prose"><Content /></div>
        </>
      )}
  </article>
</Base>

<style>
  .interesse { padding-top: 48px; }
  header { margin-bottom: 40px; }
  .aviso { margin-bottom: 24px; }
</style>
