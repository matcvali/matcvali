---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { url, campo, perfil, caminhosIdioma } from '../../lib/util';

export const getStaticPaths = caminhosIdioma;
const lang = Astro.params.lang as Lang;
const p = perfil();

const disciplinas = await getCollection('disciplinas');
const concluidas = disciplinas.filter((d) => d.data.status === 'concluida').length;
const totalDisc = disciplinas.filter((d) => d.data.status !== 'sonho').length;
const pct = totalDisc ? Math.round((concluidas / totalDisc) * 100) : 0;
const cursando = disciplinas.filter((d) => d.data.status === 'cursando');
const objetivo = disciplinas.find((d) => d.data.status === 'sonho');
const resumoCaminho =
  `${concluidas} / ${totalDisc} ${t(lang, 'cam.progresso')}.` +
  (objetivo
    ? ` ${t(lang, 'inicio.objetivo')}: ${campo(objetivo.data, 'titulo', lang)}${objetivo.data.periodo ? `, ${objetivo.data.periodo}` : ''}.`
    : '');

// Pesquisa atual: a experiência cujo período diz "atual", "hoje" etc. Se nenhuma, a primeira.
const experiencias = p.experiencias || [];
const atual =
  experiencias.find((e: any) => /atual|hoje|present|actual|andamento/i.test(String(e.periodo || ''))) ||
  experiencias[0];
const instituicao = p.formacao?.[0] ? campo(p.formacao[0], 'instituicao', lang) : '';

const iniciais = (p.nome || '?')
  .split(' ')
  .filter(Boolean)
  .map((s: string) => s[0])
  .slice(0, 2)
  .join('');

const secoes = [
  { href: `/${lang}/caminho/`, nome: t(lang, 'nav.caminho'), texto: t(lang, 'inicio.caminho') },
  { href: `/${lang}/biblioteca/`, nome: t(lang, 'nav.biblioteca'), texto: t(lang, 'inicio.biblioteca') },
  { href: `/${lang}/interesses/`, nome: t(lang, 'nav.interesses'), texto: t(lang, 'inicio.interesses') },
  { href: `/${lang}/documentos/`, nome: t(lang, 'nav.documentos'), texto: t(lang, 'inicio.documentos') },
  { href: `/${lang}/curriculo/`, nome: t(lang, 'nav.curriculo'), texto: t(lang, 'inicio.curriculo') },
];
---
<Base lang={lang} descricao={campo(p, 'bio', lang)}>
  <section class="hero wrap">
    <div class="foto">
      {p.foto ? <img src={url(p.foto)} alt={p.nome} /> : <span class="iniciais" aria-hidden="true">{iniciais}</span>}
    </div>
    <h1>{p.nome}</h1>
    <p class="cargo">{campo(p, 'titulo', lang)}{instituicao && <span>{instituicao}</span>}</p>
    <p class="bio">{campo(p, 'bio', lang)}</p>
    <div class="acoes">
      {p.email && <a class="botao" href={`mailto:${p.email}`}>{t(lang, 'geral.contato')}</a>}
      {p.lattes && <a class="secundario" href={p.lattes} target="_blank" rel="noopener">Lattes</a>}
      {(p.links || []).map((l: any) => (
        <a class="secundario" href={l.url} target="_blank" rel="noopener">{campo(l, 'nome', lang)}</a>
      ))}
    </div>
  </section>

  <section class="wrap painel">
    {atual && (
      <article class="vidro cartao pesquisa">
        <h2>{t(lang, 'inicio.pesquisa')}</h2>
        <p class="destaque">{campo(atual, 'descricao', lang) || campo(atual, 'titulo', lang)}</p>
        <p class="meta">
          {[campo(atual, 'titulo', lang), campo(atual, 'local', lang), campo(atual, 'periodo', lang)].filter(Boolean).join(', ')}
        </p>
      </article>
    )}

    <article class="vidro cartao">
      {cursando.length > 0 && (
        <>
          <h2>{t(lang, 'inicio.cursando')}</h2>
          <ul class="chips">
            {cursando.map((d) => <li>{campo(d.data, 'titulo', lang)}</li>)}
          </ul>
        </>
      )}
      <h2 class:list={{ espaco: cursando.length > 0 }}>{t(lang, 'nav.caminho')}</h2>
      <div class="barra" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
        <i style={`width:${pct}%`}></i>
      </div>
      <p class="meta">{resumoCaminho}</p>
    </article>
  </section>

  <nav class="wrap secoes" aria-label={t(lang, 'inicio.explore')}>
    {secoes.map((s) => (
      <a class="vidro" href={url(s.href)}>
        <span class="secao-nome">{s.nome}</span>
        <span class="secao-texto">{s.texto}</span>
      </a>
    ))}
  </nav>
</Base>

<style>
  .hero {
    text-align: center;
    padding-block: clamp(56px, 9vw, 96px) 48px;
  }
  .foto {
    width: 150px;
    height: 150px;
    margin: 0 auto;
    padding: 4px;
    border-radius: 50%;
    background: conic-gradient(from 200deg, var(--orange), var(--lilac), var(--orange));
  }
  .foto img, .iniciais {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
  }
  .iniciais {
    display: grid;
    place-items: center;
    background: var(--bg);
    font-size: 3rem;
    font-weight: 700;
    color: var(--ink);
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6.5vw, 4rem);
    margin: 26px 0 10px;
  }
  .cargo {
    color: var(--orange-ink);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0 0 12px;
  }
  .cargo span { display: block; color: var(--muted); font-weight: 500; font-size: 1rem; }
  .bio { color: var(--muted); max-width: 52ch; margin: 0 auto 26px; }
  .acoes { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .secundario {
    display: inline-flex;
    align-items: center;
    padding: 0.75em 1.3em;
    border-radius: var(--r-pill);
    background: var(--surface);
    border: 1px solid var(--glass-border);
    color: var(--ink);
    font-weight: 650;
    text-decoration: none;
    backdrop-filter: blur(12px);
  }
  .secundario:hover { background: var(--surface-2); color: var(--ink); }

  .painel {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 18px;
  }
  .cartao { padding: 28px; }
  .cartao h2 {
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0;
    color: var(--lilac);
    margin: 0 0 12px;
  }
  .cartao h2.espaco { margin-top: 24px; }
  .destaque {
    font-size: 1.4rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .meta { color: var(--muted); font-size: 0.92rem; margin: 0; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li {
    background: var(--surface-2);
    border-radius: var(--r-pill);
    padding: 5px 14px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .barra {
    height: 10px;
    border-radius: var(--r-pill);
    background: var(--line);
    overflow: hidden;
    margin-bottom: 10px;
  }
  .barra i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--lilac), var(--orange));
  }

  .secoes {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 18px;
  }
  .secoes a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 22px;
    border-radius: var(--r-md);
    color: var(--ink);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .secoes a:hover { background: var(--surface-2); transform: translateY(-2px); }
  .secao-nome { font-weight: 700; letter-spacing: -0.01em; }
  .secao-texto { color: var(--muted); font-size: 0.85rem; line-height: 1.45; }

  @media (max-width: 900px) {
    .painel { grid-template-columns: 1fr; }
    .secoes { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .secoes { grid-template-columns: 1fr; }
  }
</style>
