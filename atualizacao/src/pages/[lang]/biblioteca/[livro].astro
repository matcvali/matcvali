---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Capa from '../../../components/Capa.astro';
import { langs, t, type Lang } from '../../../i18n/ui';
import { url, campo, temTraducao, markdown } from '../../../lib/util';

export async function getStaticPaths() {
  const livros = await getCollection('livros');
  return langs.flatMap((lang) =>
    livros.map((livro) => ({ params: { lang, livro: livro.id }, props: { livro } })),
  );
}

const lang = Astro.params.lang as Lang;
const { livro } = Astro.props;
const d = livro.data;
const { Content } = await render(livro);
const impressaoTraduzida = lang !== 'pt' ? (d as any)[`impressao_${lang}`] : null;
const temCorpo = Boolean(livro.body?.trim());
const usei = campo(d, 'usei_para', lang);
const titulo = campo(d, 'titulo', lang);
const area = campo(d, 'area', lang);
---
<Base lang={lang} titulo={titulo}>
  <article class="wrap livro">
    <a class="voltar" href={url(`/${lang}/biblioteca/`)}>← {t(lang, 'bib.voltar')}</a>

    <div class="grade">
      <div class="lado">
        <Capa chave={d.titulo} titulo={titulo} autor={d.autor} capa={d.capa} grande />
      </div>

      <div>
        <h1>{titulo}</h1>
        <p class="autor">{d.autor}{d.ano && `, ${d.ano}`}</p>

        <div class="meta">
          <span class="pill status">{t(lang, `bib.status.${d.status}` as any)}</span>
          {area && <span class="pill">{area}</span>}
          {d.nota != null && (
            <span class="pill estrelas" aria-label={`${d.nota}/5`}>
              {Array.from({ length: 5 }, (_, i) => (
                <span class:list={{ cheia: i < Math.round(d.nota!) }}>●</span>
              ))}
            </span>
          )}
        </div>

        {usei && (
          <section class="bloco usei">
            <h2>{t(lang, 'bib.usei')}</h2>
            <p>{usei}</p>
          </section>
        )}

        {(temCorpo || impressaoTraduzida) && (
          <section class="bloco">
            <h2>{t(lang, 'bib.impressao')}</h2>
            {impressaoTraduzida
              ? <div class="prose" set:html={markdown(impressaoTraduzida)} />
              : (
                <>
                  {!temTraducao(d, 'impressao', lang) && <p class="aviso">{t(lang, 'geral.traducao')}</p>}
                  <div class="prose"><Content /></div>
                </>
              )}
          </section>
        )}
      </div>
    </div>
  </article>
</Base>

<style>
  .livro { padding-top: 48px; }
  .grade { display: grid; grid-template-columns: 260px 1fr; gap: 56px; align-items: start; }
  .lado { position: sticky; top: 110px; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin-bottom: 0.2em; }
  .autor { font-size: 1.2rem; color: var(--muted); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 36px; }
  .status { background: var(--accent); color: var(--on-accent); }
  .estrelas { gap: 3px; letter-spacing: 0; color: var(--line); }
  .estrelas .cheia { color: var(--orange); }
  .bloco h2 { font-size: 1.35rem; margin-bottom: 0.6em; }
  .bloco + .bloco { margin-top: 36px; }
  .usei {
    background: var(--surface);
    padding: 24px 28px;
    border-radius: var(--r-lg) var(--r-lg) var(--r-lg) 8px;
    max-width: 66ch;
  }
  .usei p { margin: 0; }
  @media (max-width: 760px) {
    .grade { grid-template-columns: 1fr; gap: 28px; }
    .lado { position: static; max-width: 180px; }
  }
</style>
