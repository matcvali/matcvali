---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { campo, caminhosIdioma } from '../../lib/util';

export const getStaticPaths = caminhosIdioma;
const lang = Astro.params.lang as Lang;

const todas = await getCollection('disciplinas');
const porEtapa = new Map<number, typeof todas>();
for (const d of todas) {
  if (!porEtapa.has(d.data.etapa)) porEtapa.set(d.data.etapa, []);
  porEtapa.get(d.data.etapa)!.push(d);
}
const ordemStatus = { concluida: 0, cursando: 1, planejada: 2, sonho: 3 } as const;

const etapas = [...porEtapa.entries()]
  .sort((a, b) => a[0] - b[0])
  .map(([numero, lista]) => {
    lista.sort((a, b) => ordemStatus[a.data.status] - ordemStatus[b.data.status] || a.data.titulo.localeCompare(b.data.titulo));
    const st = lista.map((d) => d.data.status);
    const estado = st.every((s) => s === 'concluida')
      ? 'concluida'
      : st.some((s) => s === 'cursando')
        ? 'cursando'
        : st.every((s) => s === 'sonho')
          ? 'sonho'
          : 'planejada';
    return { numero, lista, estado };
  });

const total = todas.filter((d) => d.data.status !== 'sonho').length;
const feitas = todas.filter((d) => d.data.status === 'concluida').length;
const pct = total ? Math.round((feitas / total) * 100) : 0;

const legenda = ['concluida', 'cursando', 'planejada', 'sonho'] as const;
---
<Base lang={lang} titulo={t(lang, 'cam.titulo')} descricao={t(lang, 'cam.intro')}>
  <div class="wrap">
    <header class="cabecalho-pagina">
      <h1>{t(lang, 'cam.titulo')}</h1>
      <p class="lede">{t(lang, 'cam.intro')}</p>

      <div class="progresso">
        <div class="barra" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
          <span style={`width:${pct}%`}></span>
        </div>
        <p><strong>{feitas}</strong> / {total} {t(lang, 'cam.progresso')}</p>
      </div>

      <ul class="legenda">
        {legenda.map((s) => (
          <li><span class={`ponto ${s}`}></span>{t(lang, `cam.${s}`)}</li>
        ))}
      </ul>
    </header>

    <ol class="mapa">
      {etapas.map((e, i) => (
        <li class:list={['etapa', e.estado, i % 2 ? 'direita' : 'esquerda']}>
          {i > 0 && (
            <svg class:list={['trilha', { feita: etapas[i - 1].estado === 'concluida' }]} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <path
                d={i % 2 ? 'M0 0 C 0 55, 100 45, 100 100' : 'M100 0 C 100 55, 0 45, 0 100'}
                vector-effect="non-scaling-stroke"
              />
            </svg>
          )}
          <div class="linha">
            <div class="marco">
              {e.estado === 'sonho'
                ? <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path fill="currentColor" d="M12 2.5c.5 0 .9.3 1.1.8l2.1 5 5.4.5c.5 0 .9.4 1 .8.2.5 0 1-.3 1.3l-4.1 3.6 1.2 5.3c.1.5-.1 1-.5 1.2-.4.3-.9.3-1.3.1L12 18.3l-4.6 2.8c-.4.2-.9.2-1.3-.1-.4-.3-.6-.8-.5-1.2l1.2-5.3L2.7 10.9c-.4-.3-.5-.8-.3-1.3.1-.4.5-.8 1-.8l5.4-.5 2.1-5c.2-.5.6-.8 1.1-.8Z"/></svg>
                : <span>{e.numero}</span>}
              <span class="sr-only">{t(lang, 'cam.etapa')} {e.numero}</span>
            </div>

            <ul class="disciplinas">
              {e.lista.map((d) => {
                const coment = campo(d.data, 'comentario', lang);
                return (
                  <li class:list={['disc', d.data.status]}>
                    <span class={`ponto ${d.data.status}`} aria-hidden="true"></span>
                    <span class="disc-texto">
                      <span class="disc-nome">{campo(d.data, 'titulo', lang)}</span>
                      {(d.data.periodo || coment) && (
                        <span class="disc-info">
                          {d.data.periodo}{d.data.periodo && coment && '. '}{coment}
                        </span>
                      )}
                    </span>
                    <span class="sr-only">({t(lang, `cam.${d.data.status}`)})</span>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .progresso { display: flex; align-items: center; gap: 18px; margin-top: 28px; flex-wrap: wrap; }
  .progresso p { margin: 0; color: var(--muted); }
  .progresso strong { color: var(--ink); font-size: 1.2rem; }
  .barra {
    flex: 1 1 260px;
    max-width: 420px;
    height: 14px;
    background: var(--surface-2);
    border-radius: var(--r-pill);
    overflow: hidden;
  }
  .barra span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--amber), var(--orange));
  }

  .legenda { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 0.92rem; color: var(--muted); }
  .legenda li { display: inline-flex; align-items: center; gap: 8px; }

  .ponto { width: 12px; height: 12px; border-radius: 50%; flex: none; display: inline-block; }
  .ponto.concluida { background: var(--orange); }
  .ponto.cursando { background: var(--bg); box-shadow: inset 0 0 0 3px var(--orange); }
  .ponto.planejada { background: var(--line); }
  .ponto.sonho { background: var(--plum); border-radius: 40% 60% 55% 45%; }

  /* ---------- mapa ---------- */
  .mapa { --m: 84px; list-style: none; padding: 0; margin: 24px 0 0; }

  .trilha {
    display: block;
    width: calc(100% - var(--m));
    margin-inline: calc(var(--m) / 2);
    height: 90px;
    overflow: visible;
  }
  .trilha path {
    fill: none;
    stroke: var(--line);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 2 14;
  }
  .trilha.feita path { stroke: var(--orange); stroke-dasharray: none; }

  .linha { display: flex; align-items: center; gap: 28px; }
  .direita .linha { flex-direction: row-reverse; }

  .marco {
    flex: none;
    width: var(--m);
    height: var(--m);
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: 2.2rem;
    font-weight: 600;
    background: var(--surface-2);
    color: var(--muted);
    position: relative;
    z-index: 1;
  }
  .concluida .marco { background: var(--orange); color: var(--bg); }
  .cursando .marco {
    background: var(--bg);
    color: var(--orange-ink);
    box-shadow: inset 0 0 0 6px var(--orange);
  }
  .cursando .marco::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 3px solid var(--orange);
    opacity: 0.35;
    animation: pulso 2.6s ease-out infinite;
  }
  .sonho .marco { background: var(--plum); color: var(--bg); border-radius: 44% 56% 50% 50% / 56% 44% 56% 44%; }
  @keyframes pulso {
    from { transform: scale(0.9); opacity: 0.5; }
    to { transform: scale(1.25); opacity: 0; }
  }

  .disciplinas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    flex: 1;
  }
  .direita .disciplinas { justify-content: flex-end; }

  .disc {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 18px 12px 14px;
    border-radius: var(--r-md);
    background: var(--surface);
    max-width: 340px;
  }
  .disc .ponto { margin-top: 6px; }
  .disc-texto { display: flex; flex-direction: column; }
  .disc-nome { font-weight: 650; line-height: 1.3; }
  .disc-info { font-size: 0.85rem; color: var(--muted); line-height: 1.4; margin-top: 2px; }
  .disc.planejada { background: transparent; box-shadow: inset 0 0 0 2px var(--line); }
  .disc.planejada .disc-nome { color: var(--muted); }
  .disc.cursando { background: var(--surface-2); }
  .disc.sonho { background: color-mix(in srgb, var(--plum) 16%, transparent); }

  @media (max-width: 640px) {
    .mapa { --m: 60px; }
    .marco { font-size: 1.6rem; }
    .linha, .direita .linha { flex-direction: column; align-items: flex-start; gap: 14px; }
    .direita .linha { align-items: flex-end; }
    .direita .disciplinas { justify-content: flex-end; }
    .disc { max-width: 100%; }
    .trilha { height: 60px; }
  }
</style>
