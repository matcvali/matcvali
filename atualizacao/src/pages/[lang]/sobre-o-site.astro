---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { campo, caminhosIdioma, markdown } from '../../lib/util';

export const getStaticPaths = caminhosIdioma;
const lang = Astro.params.lang as Lang;
const pagina = await getEntry('sobre', 'site');
const d = pagina?.data;
const { Content } = pagina ? await render(pagina) : { Content: null };
const traduzido = d && lang !== 'pt' ? (d as any)[`texto_${lang}`] : null;
const titulo = d ? campo(d, 'titulo', lang) : t(lang, 'sobre.titulo');
---
<Base lang={lang} titulo={titulo}>
  <article class="wrap sobre">
    <header class="cabecalho-pagina">
      <h1>{titulo}</h1>
    </header>
    {traduzido
      ? <div class="prose" set:html={markdown(traduzido)} />
      : (
        <>
          {lang !== 'pt' && <p class="aviso">{t(lang, 'geral.traducao')}</p>}
          <div class="prose">{Content && <Content />}</div>
        </>
      )}
  </article>
</Base>

<style>
  .aviso { margin-bottom: 24px; }
</style>
