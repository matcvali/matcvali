---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { url, campo, caminhosIdioma, formatarData } from '../../lib/util';

export const getStaticPaths = caminhosIdioma;
const lang = Astro.params.lang as Lang;
const docs = (await getCollection('documentos')).sort((a, b) => +b.data.data - +a.data.data);
---
<Base lang={lang} titulo={t(lang, 'doc.titulo')} descricao={t(lang, 'doc.intro')}>
  <div class="wrap">
    <header class="cabecalho-pagina">
      <h1>{t(lang, 'doc.titulo')}</h1>
      <p class="lede">{t(lang, 'doc.intro')}</p>
    </header>

    <ul class="docs">
      {docs.map((doc) => {
        const desc = campo(doc.data, 'descricao', lang);
        return (
          <li>
            <div class="icone" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M7 2.5h6.6c.5 0 1 .2 1.4.6l4.4 4.4c.4.4.6.9.6 1.4V19a2.5 2.5 0 0 1-2.5 2.5H7A2.5 2.5 0 0 1 4.5 19V5A2.5 2.5 0 0 1 7 2.5Zm6 1.8V8c0 .6.4 1 1 1h3.7L13 4.3ZM8 13a1 1 0 1 0 0 2h8a1 1 0 1 0 0-2H8Zm0 3.5a1 1 0 1 0 0 2h5a1 1 0 1 0 0-2H8Z"/></svg>
            </div>
            <div class="info">
              <div class="topo-doc">
                <span class="pill">{t(lang, `doc.tipo.${doc.data.tipo}` as any)}</span>
                <span class="data">{formatarData(doc.data.data, lang)}</span>
              </div>
              <h2>{campo(doc.data, 'titulo', lang)}</h2>
              {desc && <p>{desc}</p>}
            </div>
            <a class="botao" href={url(doc.data.arquivo)} target="_blank" rel="noopener">
              {t(lang, 'doc.abrir')}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .docs { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .docs li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 22px;
    padding: 22px 24px;
    background: var(--surface);
    border-radius: var(--r-lg);
  }
  .icone {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 18px 18px 18px 6px;
    background: var(--bg);
    color: var(--orange);
  }
  .topo-doc { display: flex; gap: 12px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
  .topo-doc .pill { background: var(--bg); font-size: 0.78rem; }
  .data { color: var(--muted); font-size: 0.88rem; }
  h2 { font-size: 1.35rem; margin: 0 0 4px; }
  .info p { margin: 0; color: var(--muted); max-width: 60ch; }
  @media (max-width: 680px) {
    .docs li { grid-template-columns: auto 1fr; }
    .botao { grid-column: 1 / -1; justify-self: start; }
  }
</style>
