---
import { url } from '../lib/util';
const destinos = { pt: url('/pt/'), en: url('/en/'), es: url('/es/') };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`1; url=${destinos.pt}`} />
    <title>Redirecionando</title>
    <script is:inline define:vars={{ destinos }}>
      const l = (navigator.language || 'pt').slice(0, 2);
      location.replace(destinos[l] || destinos.pt);
    </script>
  </head>
  <body><a href={destinos.pt}>Entrar</a></body>
</html>
